# Корневой .dockerignore сюда не применяется: Docker читает его из корня
# контекста сборки, а контекст здесь — сама папка frontend.

# 130 МБ, которые иначе уедут демону на каждую сборку. Зависимости всё равно
# ставятся внутри образа через npm ci, из lock-файла.
node_modules

# Локальная сборка. В образе dist создаётся заново на стадии builder.
dist
.vite

.git
.gitignore
.DS_Store
*.log
