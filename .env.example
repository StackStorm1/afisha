# Ничего из этого файла не является реальным секретом.
# Реальные значения — только в .env, который в .gitignore.

# Окружение
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=info
TZ=Europe/Moscow

# PostgreSQL (сервис db в docker-compose)
# Это единственное место, где задаются логин, пароль и имя базы — DSN для
# backend собирается из этих переменных в docker-compose.yml, а не хранится
# отдельной строкой, чтобы не разойтись при смене пароля.
POSTGRES_DB=afisha
POSTGRES_USER=afisha_app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55432

# Подключение backend к БД
# DSN целиком, а не по частям: собирать его в коде из POSTGRES_* нельзя —
# POSTGRES_PORT выше это порт публикации на хост, внутри docker-сети всегда 5432.
# Это значение для запуска backend с хост-машины (README, раздел без Docker).
# В контейнере его перекрывает docker-compose.yml своим DSN на db:5432.
DATABASE_URL=postgresql+asyncpg://afisha_app:change-me@localhost:55432/afisha
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2

# Аутентификация backend
SECRET_KEY=insecure-local-dev-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_HASH_SCHEME=bcrypt

# Приложение backend
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173

# Бизнес-правила (docs/requirements.md)
BOOKING_HOLD_MINUTES=15
BOOKING_EXPIRY_JOB_INTERVAL_SECONDS=60
# success | decline | timeout — исход заглушки платёжного шлюза
PAYMENT_GATEWAY_MODE=success

# Frontend (React + Vite)
# VITE_* переменные вшиваются в бандл на этапе сборки и попадают в JS,
# который скачивает браузер. Секретов здесь быть не может никогда.
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_PORT=5173
